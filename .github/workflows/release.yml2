name: Release
on:
  push:
    tags: ['v*']
jobs:
  release:
    runs-on: ubuntu-latest
    permissions: { contents: write }
    steps:
      - uses: actions/checkout@v4
      - name: Pack
        run: zip -r savagedus-companion.zip module.json LICENSE README.md scripts/
      - name: Publish
        uses: softprops/action-gh-release@v2
        with:
          files: |
            savagedus-companion.zip
            module.json
